# Copiado para .env por `npm run setup` (que gera ADMIN_PASSWORD). O .env NÃO é versionado.

# ---------- Backend (Node.js) ----------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=3001
# Origem permitida no CORS (frontend). Use "localhost" (contexto seguro para webcam).
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_PORT=5173
# Relativo à raiz do repositório.
DATABASE_PATH=data/face-attendance.db

# Senha da área administrativa (mín. 12 caracteres). Gerada automaticamente pelo setup se vazia.
ADMIN_PASSWORD=
ADMIN_SESSION_TTL_MINUTES=480
# true desliga a autenticação administrativa — SOMENTE em ambiente de desenvolvimento isolado.
ADMIN_AUTH_DISABLED=false

# ---------- Reconhecimento (regras aplicadas pelo backend) ----------
RECOGNITION_URL=http://127.0.0.1:8001
RECOGNITION_TIMEOUT_MS=15000
RECOGNITION_MODEL_NAME=sface
RECOGNITION_MODEL_VERSION=2021dec
RECOGNITION_EMBEDDING_DIM=128
# Limiar de similaridade por cosseno. 0.363 é o valor de referência da OpenCV para SFace e serve
# SOMENTE para desenvolvimento. Calibre com amostras reais autorizadas (docs/evaluation.md).
RECOGNITION_THRESHOLD=0.363
# Diferença mínima entre o 1º e o 2º candidato (ambos acima do limiar) para não ser ambíguo.
RECOGNITION_AMBIGUITY_MARGIN=0.05

# Intervalo mínimo entre registros do mesmo funcionário (proteção contra duplicidade acidental; não é regra trabalhista).
ATTENDANCE_DEDUP_SECONDS=30
MAX_IMAGE_BYTES=4194304
DISPLAY_TIMEZONE=America/Sao_Paulo

# Retenção do histórico de ponto em dias (0 = indefinida). Aplicada apenas via `npm run data:retention -- --apply`.
TIME_RECORDS_RETENTION_DAYS=0

# ---------- Serviço Python ----------
# Mantenha 127.0.0.1. Expor em outra interface exige avaliação de segurança (dados biométricos).
RECOGNITION_HOST=127.0.0.1
RECOGNITION_PORT=8001
RECOGNITION_MAX_IMAGE_BYTES=4194304
RECOGNITION_MIN_FACE_SIZE=64
RECOGNITION_MIN_SHARPNESS=25
RECOGNITION_DETECTION_SCORE_THRESHOLD=0.8
